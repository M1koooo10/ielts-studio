{
  "name": "ielts-studio",
  "version": "1.3.0",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:backup": "tsx scripts/db-backup.ts",
    "content:import": "tsx scripts/content-import.ts",
    "db:claim-legacy": "tsx scripts/db-claim-legacy.ts",
    "setup": "npm run db:migrate && npm run content:import",
    "content:counts": "tsx scripts/content-counts.ts"
  },
  "dependencies": {
    "@libsql/client": "latest",
    "@radix-ui/react-dialog": "latest",
    "@radix-ui/react-slot": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "drizzle-orm": "latest",
    "libphonenumber-js": "^1.13.17",
    "lucide-react": "latest",
    "next": "16.4.6",
    "openai": "latest",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "latest",
    "recharts": "latest",
    "tailwind-merge": "latest",
    "zod": "^4"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "postcss": "^8",
    "tailwindcss": "^4",
    "tsx": "latest",
    "typescript": "~5.9.3",
    "vitest": "^4"
  }
}
